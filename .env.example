# AE-03 Environment Configuration
# Copy this file to .env and fill in your real API keys.

# --- LLM Provider Keys ---
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-api-key-here
OLLAMA_HOST=http://localhost:11434

# --- n8n Webhook Integration ---
N8N_WEBHOOK_BASE_URL=https://uzaifah.app.n8n.cloud/webhook

# --- Application Settings ---
LOG_LEVEL=INFO
DEFAULT_PROVIDER=openai
DEFAULT_MODEL_OPENAI=gpt-4o
DEFAULT_MODEL_GEMINI=gemini-1.5-pro
DEFAULT_MODEL_OLLAMA=llama3
