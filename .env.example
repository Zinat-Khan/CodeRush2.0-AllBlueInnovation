# ══════════════════════════════════════════════════════════════════════
# AE-03 Environment Configuration (Directive V2)
# ══════════════════════════════════════════════════════════════════════

# ── Primary Provider Selection ────────────────────────────────────────
PRIMARY_PROVIDER=google
PRIMARY_MODEL=gemini-1.5-pro

# ── Main API 1: Google Gemini ─────────────────────────────────────────
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-1.5-pro

# ── Main API 2: OpenAI ────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ── Main API 3: Groq ──────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenRouter Fallback APIs (Keys 1-7) ────────────────────────────
OPENROUTER_KEY_1=sk-or-v1-key-1
OPENROUTER_KEY_2=sk-or-v1-key-2
OPENROUTER_KEY_3=sk-or-v1-key-3
OPENROUTER_KEY_4=sk-or-v1-key-4
OPENROUTER_KEY_5=sk-or-v1-key-5
OPENROUTER_KEY_6=sk-or-v1-key-6
OPENROUTER_KEY_7=sk-or-v1-key-7

# ── Ollama (Local Fallback) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── RAG Pipeline & PostgreSQL Vector Database ─────────────────────────
VECTOR_STORE_TYPE=postgres
EMBEDDING_PROVIDER=google
CHROMA_PERSIST_DIR=./data/chroma
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# PostgreSQL / Supabase Vector Database
POSTGRES_HOST=db.owibnpmtjhrczimayetl.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
SUPABASE_URL=https://owibnpmtjhrczimayetl.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-pub-key
SUPABASE_SECRET=your-supabase-secret-key

# ── Run Budget Limits ────────────────────────────────────────────────
MAX_RUNTIME_SECONDS=300
MAX_TOKENS=100000
MAX_COST=5.0

# ── Scratchpad / Memory ─────────────────────────────────────────────
SCRATCHPAD_TTL_SECONDS=300
MAX_SCRATCHPAD_ENTRIES=100

# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
